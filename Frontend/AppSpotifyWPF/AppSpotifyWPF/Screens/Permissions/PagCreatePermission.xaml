<Page x:Class="AppSpotifyWPF.Screens.PagCreatePermission"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <StackPanel Margin="40">

        <Button Click="Back_Click"
                Background="Transparent"
                BorderBrush="Transparent">
            <TextBlock Text="Return to Permissions"/>
        </Button>

        <TextBlock Text="Create Permission"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Background="White" Padding="20">

            <StackPanel>

                <TextBlock Text="Code"/>
                <TextBox x:Name="txtCode" Margin="0,5"/>

                <TextBlock Text="Name"/>
                <TextBox x:Name="txtName" Margin="0,5"/>

                <TextBlock Text="Description"/>
                <TextBox x:Name="txtDescription" Margin="0,5"/>

                <!-- NEW -->
                <TextBlock Text="Assign to Role"/>
                <ComboBox x:Name="RoleCombo"
                          Width="250"
                          Margin="0,5"/>

                <Button Content="Create"
                        Click="Create_Click"
                        Margin="10"
                        Background="#4CAF50"
                        Foreground="White"
                        Width="150"/>

            </StackPanel>

        </Border>

    </StackPanel>
</Page>