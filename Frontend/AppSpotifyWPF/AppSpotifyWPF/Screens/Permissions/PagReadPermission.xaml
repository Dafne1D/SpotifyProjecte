<Page x:Class="AppSpotifyWPF.Screens.PagReadPermission"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <StackPanel Margin="40">

        <Button Click="Back_Click"
                Background="Transparent"
                BorderBrush="Transparent">
            <TextBlock Text="Return to Permissions"/>
        </Button>

        <TextBlock Text="Permission Details"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <Border Background="White" Padding="20">

            <StackPanel>

                <TextBlock Text="Code" FontWeight="Bold"/>
                <TextBlock x:Name="txtCode" Margin="0,5"/>

                <TextBlock Text="Name" FontWeight="Bold"/>
                <TextBlock x:Name="txtName" Margin="0,5"/>

                <TextBlock Text="Description" FontWeight="Bold"/>
                <TextBlock x:Name="txtDescription" Margin="0,5"/>

            </StackPanel>

        </Border>

    </StackPanel>
</Page>