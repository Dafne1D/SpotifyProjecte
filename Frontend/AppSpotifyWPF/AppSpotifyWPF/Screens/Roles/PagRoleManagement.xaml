<Page x:Class="AppSpotifyWPF.PagRoleManagement"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Role Management"
      Background="#F5F6FA">

    <ScrollViewer>
        <StackPanel Margin="40">

            <!-- HEADER -->
            <StackPanel>

                <Button
                     Margin="0 0 0 5"
                     Background="Transparent"
                     Foreground="Gray"
                     BorderBrush="Transparent"
                     Click="BackToHome_Click"
                     HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE76B;"
                                   FontSize="16"
                                   Margin="0 0 10 0"/>
                        <TextBlock Text="Back to Home"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                
                

                <TextBlock Text="Role Management"
                           FontSize="28"
                           FontWeight="Bold"/>
            </StackPanel>

            <!-- LOAD -->
            <Button Content="Load"
                    Width="150"
                    Height="35"
                    Margin="0,20,0,20"
                    Background="#4CAF50"
                    Foreground="White"
                    Click="OnLoadClicked"/>

            <!-- ROLES -->
            <WrapPanel x:Name="RolesContainer"
                       HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>
</Page>