<Page x:Class="AppSpotifyWPF.Screens.Songs.PagReadSong"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <Grid>
        <StackPanel Margin="40">

            <Button Click="BackToHome_Click"
                    Background="Transparent"
                    BorderBrush="Transparent">
                <TextBlock Text="Return to Songs"/>
            </Button>

            <TextBlock Text="Song Details"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White" Padding="20">

                <StackPanel>

                    <TextBlock Text="Title:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtTitle" Margin="0,0,0,10"/>

                    <TextBlock Text="Artist:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtArtist" Margin="0,0,0,10"/>

                    <TextBlock Text="Album:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtAlbum" Margin="0,0,0,10"/>

                    <TextBlock Text="Duration:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtDuration" Margin="0,0,0,10"/>

                    <TextBlock Text="Genre:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtGenre" Margin="0,0,0,10"/>

                    <TextBlock Text="Image URL:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtImageUrl"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>
</Page>