<Page x:Class="AppSpotifyWPF.Screens.Songs.PagCreateSong"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40">

            <!-- RETURN -->
            <Button
                Background="Transparent"
                Foreground="Gray"
                BorderBrush="Transparent"
                Click="BackToHome_Click"
                HorizontalAlignment="Left">

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE76B;"
                               Margin="0 0 10 0"/>
                    <TextBlock Text="Back to Home"
                               FontWeight="Bold"/>
                </StackPanel>
            </Button>

            <TextBlock Text="Create Song"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White" Padding="20">

                <StackPanel>

                    <!-- TITLE -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Title:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtName" Width="250" Height="30"/>
                    </StackPanel>

                    <!-- ARTIST -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Artist:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtArtist" Width="250" Height="30"/>
                    </StackPanel>

                    <!-- ALBUM -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Album:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtAlbum" Width="250" Height="30"/>
                    </StackPanel>

                    <!-- DURATION -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Duration:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtDuration" Width="250" Height="30"/>
                    </StackPanel>

                    <!-- GENRE -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Genre:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtGenre" Width="250" Height="30"/>
                    </StackPanel>

                    <!-- IMAGE URL -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Image URL:" Width="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtImageUrl" Width="250" Height="30"/>
                    </StackPanel>

                    <Button Content="Create"
                            Click="CreateSong_Click"
                            Background="#4CAF50"
                            Foreground="White"
                            Width="150"
                            Height="35"
                            Margin="10,10,0,0"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>