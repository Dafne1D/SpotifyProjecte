<Page x:Class="AppSpotifyWPF.Screens.Songs.PagUpdateSong"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <Grid>
        <StackPanel Margin="40">

            <Button Click="Back_Click"
                    Background="Transparent"
                    BorderBrush="Transparent">
                <TextBlock Text="Return to Songs"/>
            </Button>

            <TextBlock Text="Update Song"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White" Padding="20">

                <StackPanel>

                    <TextBox x:Name="txtName" Margin="5"/>
                    <TextBox x:Name="txtArtist" Margin="5"/>
                    <TextBox x:Name="txtAlbum" Margin="5"/>
                    <TextBox x:Name="txtDuration" Margin="5"/>
                    <TextBox x:Name="txtGenre" Margin="5"/>
                    <TextBox x:Name="txtImageUrl" Margin="5"/>

                    <Button Content="Update"
                            Click="Update_Click"
                            Margin="10"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>
</Page>