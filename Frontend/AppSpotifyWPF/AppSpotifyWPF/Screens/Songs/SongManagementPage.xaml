<Page x:Class="AppSpotifyWPF.Screens.Songs.SongManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA"
      Loaded="Page_Loaded">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="40">

                <!-- Back -->
                <Button Background="Transparent"
                        Foreground="Gray"
                        BorderBrush="Transparent"
                        Click="BackToHome_Click"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE76B;"
                                   Margin="0 0 10 0"/>
                        <TextBlock Text="Back to Home"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Title + Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Song Management"
                               FontSize="28"
                               FontWeight="Bold"/>

                    <StackPanel Orientation="Horizontal"
                                Grid.Column="1"
                                HorizontalAlignment="Right">

                        <!-- Create -->
                        <Viewbox>
                            <Button Background="LimeGreen"
                                    Click="NewSong_Click"
                                    Margin="10 0"
                                    Padding="10"
                                    Width="50"
                                    Height="50">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE710;"
                                           FontSize="28"/>
                            </Button>
                        </Viewbox>

                        <!-- View -->
                        <Viewbox>
                            <Button Click="ViewSong_Click"
                                    Margin="10 0"
                                    Padding="10"
                                    Width="50"
                                    Height="50">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE7B3;"
                                           FontSize="28"/>
                            </Button>
                        </Viewbox>

                        <!-- Update -->
                        <Viewbox>
                            <Button Click="EditSong_Click"
                                    Margin="10 0"
                                    Padding="10"
                                    Width="50"
                                    Height="50">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE70F;"
                                           FontSize="28"/>
                            </Button>
                        </Viewbox>

                        <!-- Delete -->
                        <Viewbox>
                            <Button Background="Red"
                                    Click="DeleteSong_Click"
                                    Margin="10 0"
                                    Padding="10"
                                    Width="50"
                                    Height="50">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE74D;"
                                           FontSize="28"/>
                            </Button>
                        </Viewbox>

                    </StackPanel>
                </Grid>

                <!-- Content -->
                <Border Background="White"
                        Padding="20"
                        Margin="0,20,0,0"
                        CornerRadius="10">

                    <StackPanel>

                        <TextBox x:Name="txtSearch"
                                 Width="300"
                                 Height="35"
                                 Margin="0,0,0,10"/>

                        <Button Content="Load"
                                Width="120"
                                Height="35"
                                Margin="0,0,0,20"
                                Background="#4CAF50"
                                Foreground="White"
                                Click="LoadSongs_Click"/>

                        <WrapPanel x:Name="SongsWrap"
                                   HorizontalAlignment="Left"/>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>