<Page x:Class="AppSpotifyWPF.Screens.Playlists.PagReadPlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <Grid>
        <StackPanel Margin="40">

            <Button Click="BackToHome_Click"
                    Background="Transparent"
                    BorderBrush="Transparent">
                <TextBlock Text="Return to Playlists"/>
            </Button>

            <TextBlock Text="Playlist Details"
                       FontSize="28"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Background="White" Padding="20">

                <StackPanel>

                    <TextBlock Text="Name:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtName" Margin="0,0,0,10"/>

                    <TextBlock Text="Description:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtDescription" Margin="0,0,0,10"/>

                    <TextBlock Text="Image URL:" FontWeight="Bold"/>
                    <TextBlock x:Name="txtImageUrl"/>

                </StackPanel>

            </Border>

        </StackPanel>
    </Grid>
</Page>