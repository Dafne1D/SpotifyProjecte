<Page x:Class="AppSpotifyWPF.Screens.Playlists.PagUpdatePlaylist"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F5F6FA">

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="40">

                <!-- RETURN TO PLAYLISTS -->
                <Button
                    Background="Transparent"
                    Foreground="Gray"
                    BorderBrush="Transparent"
                    Click="BackToHome_Click"
                    HorizontalAlignment="Left">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE76B;"
                                   Margin="0 0 10 0"/>
                        <TextBlock Text="Return to Playlists"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <TextBlock Text="Update Playlist"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <Border Background="White" Padding="20">

                    <StackPanel>

                        <!-- NAME -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Name:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtName"
                                     Width="250"
                                     Height="35"/>
                        </StackPanel>

                        <!-- DESCRIPTION -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Description:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtDescription"
                                     Width="250"
                                     Height="35"/>
                        </StackPanel>

                        <!-- IMAGE URL -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Image URL:" Width="120" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtImageUrl"
                                     Width="250"
                                     Height="35"/>
                        </StackPanel>

                        <Button Content="Update"
                                Click="Update_Click"
                                Margin="10,10,0,0"
                                Background="#4CAF50"
                                Foreground="White"
                                Width="150"
                                Height="35"/>

                    </StackPanel>

                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>